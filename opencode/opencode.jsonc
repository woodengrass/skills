{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "websearch": { "provider": "exa" },
  // Last matching rule wins. Agent rules are appended after these.
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },

    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },

    { "action": "shell", "resource": "git add -A *", "effect": "deny" },
    { "action": "shell", "resource": "git add --all *", "effect": "deny" },
    { "action": "shell", "resource": "git add .", "effect": "deny" },
    { "action": "shell", "resource": "git add . *", "effect": "deny" },

    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue create *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh release *", "effect": "ask" },
    // gh repo and gh api only ask when they change something; reading is allowed.
    { "action": "shell", "resource": "gh repo create *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo rename *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo archive *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo unarchive *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo fork *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo sync *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo deploy-key *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *-X*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--method*", "effect": "ask" },
    { "action": "shell", "resource": "gh api * -f *", "effect": "ask" },
    { "action": "shell", "resource": "gh api * -F *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--field*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--raw-field*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--input*", "effect": "ask" },
    { "action": "shell", "resource": "npm publish *", "effect": "ask" },
    // Config that defines checks and permissions: an agent may not change it without asking.
    { "action": "edit", "resource": ".opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "*/.opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "opencode.json*", "effect": "ask" },
    { "action": "edit", "resource": "*/opencode.json*", "effect": "ask" },
    { "action": "edit", "resource": "~/.config/opencode/*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@1.13.0"],
        "disabled": false,
        "timeout": { "catalog": 60000, "execution": 60000 }
      }
    }
  }
}
